# ===================================
# LLM Configuration (脚本生成)
# ===================================

# DeepSeek API (官方)
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# GLM (智谱AI) - 支持多模态
GLM_API_KEY=your-glm-api-key
GLM_MODEL=glm-4.6v

# LLM Provider Selection
# 可选值: "deepseek" | "glm" | "ark" (火山方舟托管的模型)
LLM_PROVIDER=ark

# 各功能可独立选模型；auto 表示按已配置服务和默认模型自动选择
BRIEF_ANALYSIS_PROVIDER=auto
SHOT_COUNT_PROVIDER=auto
REFERENCE_ANALYSIS_PROVIDER=auto

# 火山方舟托管的 LLM 模型 (仅当 LLM_PROVIDER=ark 时使用)
# 可选: doubao-1-5-pro-32k, doubao-1-8-pro, deepseek-v3-2-251201
ARK_LLM_MODEL=deepseek-v3-2-251201

# ===================================
# Volcengine Ark Configuration (图像/视频生成)
# ===================================

# 获取方式: https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
ARK_API_KEY=your-ark-api-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 视频生成模型
ARK_VIDEO_MODEL=doubao-seedance-1-5-pro
# 图像生成模型
ARK_IMAGE_MODEL=doubao-seedream-4-5-251128
# 多模态模型（用于参考图分析）
ARK_VISION_MODEL=doubao-seed-1-6-251015

# ===================================
# Image Generation Parameters (图像生成参数)
# ===================================

# 图像生成服务商
# 可选值: "ark" | "grsai"
IMAGE_PROVIDER=ark

# 图像宽高比: "1:1", "16:9", "9:16", "4:3", "3:4"
IMAGE_ASPECT_RATIO=16:9

# 可选风格描述，如 "赛璐璐渲染", "工作室灯光", "电影级光影"
IMAGE_STYLE=

# 参考图风格权重 (0.0-1.0)，越高越接近参考图风格
IMAGE_STYLE_WEIGHT=0.7

# ===================================
# GRSAI Nano Banana Configuration
# ===================================

# 你的 GRSAI Key，接入 Nano Banana 系列模型时使用
GRSAI_API_KEY=
GRSAI_BASE_URL=https://grsai.dakka.com.cn

# 默认使用的 GRSAI 图像模型
GRSAI_IMAGE_MODEL=nano-banana-fast

# 仅部分 GRSAI 模型支持 imageSize；4K 专用模型会自动切到 4K
GRSAI_IMAGE_SIZE=1K

# 轮询结果接口的间隔秒数
GRSAI_RESULT_POLL_INTERVAL_SECONDS=2

# ===================================
# Character Consistency Parameters (角色一致性)
# ===================================

# 固定随机种子，确保所有分镜风格一致（留空则自动生成）
IMAGE_SEED=

# 角色外貌描述前缀，会自动添加到每个分镜的视觉描述开头
# 示例: "一只金色柯基犬，戴着红色围巾，大眼睛，圆润的脸"
CHARACTER_DESCRIPTION=

# ===================================
# Workflow Configuration (工作流配置)
# ===================================

# 并发任务数量
WORKFLOW_CONCURRENCY=2

# 输出目录
OUTPUT_DIR=outputs

# ===================================
# Project workspace / durable state
# ===================================
DATABASE_PATH=outputs/video_workflow.sqlite3
PROJECTS_DIR=outputs/projects

# ===================================
# Self-hosted ComfyUI / MiniMax H3
# ===================================
# AutoDL example: https://u71482-xxxxxxxx.westd.seetacloud.com:8443
COMFYUI_BASE_URL=http://127.0.0.1:6006
COMFYUI_API_TOKEN=
COMFYUI_REQUEST_TIMEOUT_SECONDS=120
COMFYUI_POLL_INTERVAL_SECONDS=2
COMFYUI_JOB_TIMEOUT_SECONDS=3600
COMFYUI_VERIFY_TLS=true
COMFYUI_TRUST_ENV=false
COMFYUI_HOURLY_RATE=3.03
H3_RENDER_CONCURRENCY=1
H3_DEFAULT_WIDTH=1344
H3_DEFAULT_HEIGHT=768
H3_DEFAULT_FPS=24
H3_DEFAULT_REF_IMAGE_SIZE=match

# Optional overrides. Empty values use bundled workflows supporting official
# native 20-step quality and Turbo 4-step preview sampling.
COMFYUI_H3_I2V_WORKFLOW=
COMFYUI_H3_R2V_WORKFLOW=

# ===================================
# Final render
# ===================================
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
FINAL_VIDEO_CODEC=libx264
FINAL_AUDIO_CODEC=aac
FINAL_AUDIO_SAMPLE_RATE=48000
FINAL_VIDEO_PRESET=slow
FINAL_VIDEO_CRF=14
